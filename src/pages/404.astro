---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Page not found | AAO1">
  <section class="page-hero"><div class="container"><span class="eyebrow">404 · Page not found</span><h1>This page isn't here.</h1><p>The address may have changed, or the page may not exist yet. Return to the AAO1 homepage to continue exploring.</p><a class="button" style="margin-top:24px" href={base}>Back to homepage <span aria-hidden="true">↗</span></a></div></section>
</BaseLayout>
