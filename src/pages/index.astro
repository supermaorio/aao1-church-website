---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../content/site.json';

const base = import.meta.env.BASE_URL;
const asset = (path: string) => path ? `${base}${path.replace(/^\//, '')}` : '';
const allSermons = Object.values(import.meta.glob('../content/sermons/*.json', { eager: true, import: 'default' }));
const allEvents = Object.values(import.meta.glob('../content/events/*.json', { eager: true, import: 'default' }));
const allAnnouncements = Object.values(import.meta.glob('../content/announcements/*.json', { eager: true, import: 'default' }));
const sermons = allSermons.filter((item: any) => item.published && item.title).sort((a: any, b: any) => String(b.date).localeCompare(String(a.date))).slice(0, 3);
const events = allEvents.filter((item: any) => item.published && item.title).sort((a: any, b: any) => String(a.date).localeCompare(String(b.date))).slice(0, 3);
const announcements = allAnnouncements.filter((item: any) => item.published && item.title).slice(0, 2);
---
<BaseLayout title="AAO1 | Word • Witness • Worship" description="Welcome to AAO1. Discover our church, explore biblical teaching, and find ways to connect.">
  <section class="hero">
    {site.heroImage && <img class="hero-image" src={asset(site.heroImage)} alt="" aria-hidden="true" />}
    <div class="container hero-inner">
      <span class="eyebrow">{site.heroEyebrow}</span>
      <h1>{site.heroTitle}</h1>
      <p class="hero-copy">{site.heroDescription}</p>
      <div class="hero-actions">
        <a class="button" href={`${base}about/`}>Discover AAO1 <span aria-hidden="true">↗</span></a>
        <a class="button button-outline" href={`${base}sermons/`}>Explore sermons <span aria-hidden="true">→</span></a>
      </div>
      <div class="hero-meta">
        <div><strong>01</strong>Word</div>
        <div><strong>02</strong>Witness</div>
        <div><strong>03</strong>Worship</div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container welcome-grid">
      <div class="welcome-art" aria-label="Decorative cross illustration">
        <div class="art-cross" aria-hidden="true">†</div>
        <span class="art-caption">Word · Witness · Worship</span>
      </div>
      <div class="welcome-copy">
        <span class="eyebrow">Welcome to {site.churchName}</span>
        <h2>{site.welcomeTitle}</h2>
        <p>{site.welcomeText}</p>
        <a class="text-link" href={`${base}about/`}>Learn about our church <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container">
      <div class="section-head">
        <div><span class="eyebrow">Our foundation</span><h2>Three expressions of one faith</h2></div>
        <p>These three words shape the story and direction of this website. The final wording should be reviewed against AAO1's approved materials.</p>
      </div>
      <div class="values-grid">
        <article class="value-card"><span class="value-number">01</span><h3>Word</h3><p>Grounding faith and daily life in the truth of Scripture.</p></article>
        <article class="value-card"><span class="value-number">02</span><h3>Witness</h3><p>Reflecting the love and good news of Jesus in the world.</p></article>
        <article class="value-card"><span class="value-number">03</span><h3>Worship</h3><p>Responding to God with gratitude, reverence, and a life of devotion.</p></article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div><span class="eyebrow">Watch and grow</span><h2>Latest sermons</h2></div>
        <a class="text-link" href={`${base}sermons/`}>View all sermons <span aria-hidden="true">→</span></a>
      </div>
      {sermons.length ? <div class="card-grid">{sermons.map((sermon: any) => <article class="content-card">{sermon.coverImage && <img class="card-image" src={asset(sermon.coverImage)} alt="" loading="lazy" />}<span class="card-kicker">{sermon.scripture || 'Sermon'}</span><h3>{sermon.title}</h3><p>{sermon.summary}</p><div class="card-bottom"><span>{sermon.speaker || 'AAO1'}</span>{sermon.videoUrl ? <a href={sermon.videoUrl} target="_blank" rel="noreferrer">Watch ↗</a> : <span>{sermon.date}</span>}</div></article>)}</div> : <div class="empty-note">Sermons will appear here once approved entries are added and published through the content editor.</div>}
    </div>
  </section>

  <section class="section" style="background:#eeece6">
    <div class="container">
      <div class="section-head">
        <div><span class="eyebrow">Life together</span><h2>Upcoming events</h2></div>
        <a class="text-link" href={`${base}events/`}>See all events <span aria-hidden="true">→</span></a>
      </div>
      {events.length ? <div class="card-grid">{events.map((event: any) => <article class="content-card">{event.coverImage && <img class="card-image" src={asset(event.coverImage)} alt="" loading="lazy" />}<span class="card-kicker">{event.date}{event.time ? ` · ${event.time}` : ''}</span><h3>{event.title}</h3><p>{event.description}</p><div class="card-bottom"><span>{event.location || 'AAO1'}</span>{event.registrationUrl ? <a href={event.registrationUrl} target="_blank" rel="noreferrer">Details ↗</a> : <span>Church event</span>}</div></article>)}</div> : <div class="empty-note">Published church events will appear here. No event dates or schedules have been assumed.</div>}
    </div>
  </section>

  {announcements.length > 0 && <section class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">Stay informed</span><h2>Announcements</h2></div></div><div class="card-grid">{announcements.map((item: any) => <article class="content-card"><span class="card-kicker">{item.date}</span><h3>{item.title}</h3><p>{item.summary}</p></article>)}</div></div></section>}

  <section class="section section-dark">
    <div class="container section-head">
      <div><span class="eyebrow">Take your next step</span><h2>There is a place for you here.</h2></div>
      <div><p>Find out how to visit, get in touch, and learn more about the life of AAO1.</p><a class="button" style="margin-top:22px" href={`${base}connect/`}>Connect with us <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>
</BaseLayout>
