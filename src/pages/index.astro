---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../content/site.json';

const base = import.meta.env.BASE_URL;
const asset = (path: string) => path ? `${base}${path.replace(/^\//, '')}` : '';
const allEvents = Object.values(import.meta.glob('../content/events/*.json', { eager: true, import: 'default' }));
const allAnnouncements = Object.values(import.meta.glob('../content/announcements/*.json', { eager: true, import: 'default' }));
const events = allEvents.filter((item: any) => item.published && item.title).sort((a: any, b: any) => String(a.date).localeCompare(String(b.date))).slice(0, 3);
const announcements = allAnnouncements.filter((item: any) => item.published && item.title).slice(0, 2);

const beliefs = [
  { title: 'Of the Scriptures', href: 'https://www.aao1.org/brizy-3405/' },
  { title: 'God', href: 'https://www.aao1.org/brizy-3423/' },
  { title: 'God the Father', href: 'https://www.aao1.org/god-copy/' },
  { title: 'God the Son', href: 'https://www.aao1.org/god-the-son/' },
  { title: 'God the Holy Spirit', href: 'https://www.aao1.org/god-the-holy-spirit/' },
  { title: 'The Virgin Birth', href: 'https://www.aao1.org/the-virgin-birth/' },
  { title: 'Salvation', href: 'https://www.aao1.org/salvation/' },
  { title: 'Resurrection & Priesthood of Christ', href: 'https://www.aao1.org/resurrection-and-priesthood-of-christ/' },
  { title: 'Man', href: 'https://www.aao1.org/man/' },
  { title: 'The Gospel', href: 'https://www.aao1.org/the-gospel/' },
  { title: 'Grace & the New Birth', href: 'https://www.aao1.org/grace-and-the-new-birth/' },
  { title: 'The Atonement of Christ', href: 'https://www.aao1.org/the-atonement-of-christ/' },
  { title: 'The Grace of God', href: 'https://www.aao1.org/the-grace-of-god/' },
  { title: 'The Regeneration of the Sinner', href: 'https://www.aao1.org/the-regeneration-of-the-sinner/' },
  { title: 'The Election to Salvation', href: 'https://www.aao1.org/the-election-to-salvation/' },
  { title: 'The Sovereignty of God', href: 'https://www.aao1.org/the-sovereignty-of-god/' },
  { title: 'The Free Will of Man', href: 'https://www.aao1.org/the-free-will-of-man/' },
  { title: 'The Great Commission', href: 'https://www.aao1.org/the-great-commission/' },
  { title: 'Justification', href: 'https://www.aao1.org/justification/' },
  { title: 'Sanctification', href: 'https://www.aao1.org/sanctification/' },
  { title: 'The Security of the Believers', href: 'https://www.aao1.org/the-security-of-the-believers/' },
  { title: 'The Church', href: 'https://www.aao1.org/the-church/' },
  { title: 'Baptism and the Lord’s Supper', href: 'https://www.aao1.org/baptism-and-the-lords-supper/' },
  { title: 'Angels', href: 'https://www.aao1.org/angels/' },
  { title: 'Separation', href: 'https://www.aao1.org/separation/' },
  { title: 'Civil Government', href: 'https://www.aao1.org/civil-government/' },
  { title: 'Israel', href: 'https://www.aao1.org/israel/' },
  { title: 'Last Things (Eschatology)', href: 'https://www.aao1.org/last-things-eschatology/' },
  { title: 'Apostles’ Creed', href: 'https://www.aao1.org/apostles-creed/' },
  { title: 'Athanasian Creed', href: 'https://www.aao1.org/athanasian-creed/' },
  { title: 'Nicene Creed', href: 'https://www.aao1.org/nicene-creed/' }
];

const resources = [
  { name: 'EG', detail: 'AAO1-listed discipleship resource', href: null },
  { name: 'BibleProject', detail: 'Biblical themes, books, and videos', href: 'https://bibleproject.com/' },
  { name: 'YouVersion', detail: 'Bible reading and study', href: 'https://www.youversion.com/' },
  { name: 'AAO1 Site Resources', detail: 'Resources curated by AAO1', href: 'https://www.aao1.org/' },
  { name: 'RSG', detail: 'AAO1-listed discipleship resource', href: null },
  { name: 'AAO1 Fellowship Services', detail: 'Fellowship and ministry resources', href: 'https://www.aao1.org/' },
  { name: 'DTBM', detail: 'Discover the Book Ministries', href: 'https://dtbm.org/' },
  { name: 'Behold Israel', detail: 'Biblical teaching and Israel updates', href: 'https://www.beholdisrael.org/' }
];
---
<BaseLayout title="AAO1 | Word • Witness • Worship" description="Welcome to AAO1. Discover our church, explore biblical teaching, and find ways to connect.">
  <section class="hero">
    {site.heroImage && <img class="hero-image" src={asset(site.heroImage)} alt="" aria-hidden="true" />}
    <div class="container hero-inner">
      <span class="eyebrow">{site.heroEyebrow}</span>
      <h1>{site.heroTitle}</h1>
      <p class="hero-copy">{site.heroDescription}</p>
      <div class="hero-actions">
        <a class="button" href={`${base}about/`}>Discover AAO1 <span aria-hidden="true">↗</span></a>
        <a class="button button-outline" href={`${base}sermons/`}>Explore sermons <span aria-hidden="true">→</span></a>
      </div>
      <div class="hero-meta">
        <div><strong>01</strong>Word</div>
        <div><strong>02</strong>Witness</div>
        <div><strong>03</strong>Worship</div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container welcome-grid">
      <div class="welcome-art" aria-label="Decorative cross illustration">
        <div class="art-cross" aria-hidden="true">†</div>
        <span class="art-caption">Word · Witness · Worship</span>
      </div>
      <div class="welcome-copy">
        <span class="eyebrow">Welcome to {site.churchName}</span>
        <h2>{site.welcomeTitle}</h2>
        <p>{site.welcomeText}</p>
        <a class="text-link" href={`${base}about/`}>Learn about our church <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container">
      <div class="section-head">
        <div><span class="eyebrow">Our foundation</span><h2>Three expressions of one faith</h2></div>
        <p>These three words shape the story and direction of this website. The final wording should be reviewed against AAO1's approved materials.</p>
      </div>
      <div class="values-grid">
        <article class="value-card"><span class="value-number">01</span><h3>Word</h3><p>Grounding faith and daily life in the truth of Scripture.</p></article>
        <article class="value-card"><span class="value-number">02</span><h3>Witness</h3><p>Reflecting the love and good news of Jesus in the world.</p></article>
        <article class="value-card"><span class="value-number">03</span><h3>Worship</h3><p>Responding to God with gratitude, reverence, and a life of devotion.</p></article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div><span class="eyebrow">What we believe</span><h2>Statement of Faith</h2></div>
        <a class="text-link" href="https://www.aao1.org/" target="_blank" rel="noreferrer">View AAO1 main website <span aria-hidden="true">↗</span></a>
      </div>
      <p class="prose">Explore the biblical convictions and doctrinal topics presented by AAO1. Each topic opens its corresponding statement on the main church website.</p>
      <div class="belief-grid">
        {beliefs.map((belief) => <a class="belief-link" href={belief.href} target="_blank" rel="noreferrer">{belief.title}<span aria-hidden="true">↗</span></a>)}
      </div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container">
      <div class="section-head">
        <div><span class="eyebrow">Grow in the Word</span><h2>Discipleship Resources</h2></div>
        <p>Tools and teaching resources featured by AAO1 to support Bible study, spiritual growth, and discipleship.</p>
      </div>
      <div class="resource-grid">
        {resources.map((resource) => <article class="resource-card">
          <span class="resource-mark" aria-hidden="true">✦</span>
          <h3>{resource.name}</h3>
          <p>{resource.detail}</p>
          {resource.href ? <a class="text-link" href={resource.href} target="_blank" rel="noreferrer">Explore resource <span aria-hidden="true">↗</span></a> : <span class="resource-note">Listed on AAO1.org</span>}
        </article>)}
      </div>
      <p class="resource-footnote">Resource names follow the list displayed on AAO1.org. “RSG” is retained as written on the source site; its full name and destination were not specified there.</p>
    </div>
  </section>

  <section class="section" style="background:#eeece6">
    <div class="container">
      <div class="section-head">
        <div><span class="eyebrow">Life together</span><h2>Upcoming events</h2></div>
        <a class="text-link" href={`${base}events/`}>See all events <span aria-hidden="true">→</span></a>
      </div>
      {events.length ? <div class="card-grid">{events.map((event: any) => <article class="content-card">{event.coverImage && <img class="card-image" src={asset(event.coverImage)} alt="" loading="lazy" />}<span class="card-kicker">{event.date}{event.time ? ` · ${event.time}` : ''}</span><h3>{event.title}</h3><p>{event.description}</p><div class="card-bottom"><span>{event.location || 'AAO1'}</span>{event.registrationUrl ? <a href={event.registrationUrl} target="_blank" rel="noreferrer">Details ↗</a> : <span>Church event</span>}</div></article>)}</div> : <div class="empty-note">Published church events will appear here. No event dates or schedules have been assumed.</div>}
    </div>
  </section>

  {announcements.length > 0 && <section class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">Stay informed</span><h2>Announcements</h2></div></div><div class="card-grid">{announcements.map((item: any) => <article class="content-card"><span class="card-kicker">{item.date}</span><h3>{item.title}</h3><p>{item.summary}</p></article>)}</div></div></section>}

  <section class="section section-dark">
    <div class="container section-head">
      <div><span class="eyebrow">Take your next step</span><h2>There is a place for you here.</h2></div>
      <div><p>Find out how to visit, get in touch, and learn more about the life of AAO1.</p><a class="button" style="margin-top:22px" href={`${base}connect/`}>Connect with us <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>
</BaseLayout>
